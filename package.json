{
  "name": "lingot",
  "private": true,
  "type": "module",
  "description": "Billabex Design System",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "storybook": "pnpm --filter @billabex/ui-docs dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=24"
  }
}
