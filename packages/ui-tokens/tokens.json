        "$type": "shadow"
      },
      "lg": {
        "$value": {
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "28px",
          "spread": "-6px",
          "color": "rgba(28, 28, 26, 1)"
        },
        "$type": "shadow"
      }
