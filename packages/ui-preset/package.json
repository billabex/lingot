{
  "name": "@billabex/ui-preset",
  "version": "0.1.1",
  "description": "Optional Panda CSS preset for the Billabex design system",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@billabex/ui-tokens": "workspace:*",
    "@pandacss/dev": "^0.52.0"
  },
  "devDependencies": {
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/billabex/lingot.git",
    "directory": "packages/ui-preset"
  },
  "sideEffects": false
}
