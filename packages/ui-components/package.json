{
  "name": "@billabex/ui-components",
  "version": "0.1.0",
  "description": "React components for the Billabex design system — RSC compatible with prebuilt CSS",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "codegen": "pnpm --filter @billabex/ui-preset build && panda codegen && panda cssgen --outfile styled-system/styles.css",
    "build": "pnpm --filter @billabex/ui-preset build && panda codegen && panda cssgen --outfile styled-system/styles.css && vite build",
    "build:ship": "pnpm --filter @billabex/ui-preset build && panda ship --outfile dist/panda.buildinfo.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist styled-system",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@billabex/ui-tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@billabex/ui-preset": "workspace:*",
    "@pandacss/dev": "^0.52.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/billabex/lingot.git",
    "directory": "packages/ui-components"
  },
  "sideEffects": [
    "*.css"
  ]
}
